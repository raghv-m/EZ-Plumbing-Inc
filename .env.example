# Environment Variables Example
# Copy this file to .env and fill in your actual values

# Google Maps API Key (for Contact page map)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Contact Form Configuration (if using a backend service)
VITE_FORM_ENDPOINT=your_form_endpoint_here

# Analytics (optional)
VITE_GA_TRACKING_ID=your_google_analytics_id_here

# Site URL (for production)
VITE_SITE_URL=https://ezplumbinginc.com

